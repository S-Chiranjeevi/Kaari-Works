# PostgreSQL. docker compose up -d db starts the included local database.
DATABASE_URL=postgresql+psycopg://artisan:artisan_dev_password@localhost:5432/artisanmart

# Clerk Dashboard > API keys. Keep the secret key on the server only.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_PDZWe7pPLGFTekF7IZa2X3KRlQJ6rTz6FeWjsqA6Vs
# Copy the instance issuer (for example https://your-instance.clerk.accounts.dev).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Instance JWKS endpoint. For Clerk's Frontend API you can also use its
# /.well-known/jwks.json endpoint.
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
# Exact browser origins allowed to use the API and issue Clerk sessions.
CLERK_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

